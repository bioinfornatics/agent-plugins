{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Agent Plugin: CLI help",
      "type": "process",
      "command": "bun",
      "args": [
        "run",
        "start",
        "--help"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Print CLI help; no host calls."
    },
    {
      "label": "Agent Plugin: Evaluation help",
      "type": "process",
      "command": "bun",
      "args": [
        "run",
        "start",
        "evaluation",
        "--help"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Print evaluation options; no host calls."
    },
    {
      "label": "Agent Plugin: Lint",
      "type": "process",
      "command": "bun",
      "args": [
        "run",
        "lint"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Read-only lint; warnings and errors fail."
    },
    {
      "label": "Agent Plugin: Typecheck source",
      "type": "process",
      "command": "bun",
      "args": [
        "x",
        "--no-install",
        "tsc",
        "--noEmit",
        "--project",
        "tsconfig.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Source-only check using installed TypeScript; no dependency download."
    },
    {
      "label": "Agent Plugin: Typecheck all",
      "type": "process",
      "command": "bun",
      "args": [
        "run",
        "typecheck"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Includes historical test imports; may fail on retired modules."
    },
    {
      "label": "Agent Plugin: Test focused",
      "type": "process",
      "command": "bun",
      "args": [
        "test",
        "./tests/scaffold",
        "./tests/evaluation",
        "./tests/execution"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Current CLI, preparation and fake-host execution checks; not full acceptance.",
      "group": "test"
    },
    {
      "label": "Agent Plugin: Test all",
      "type": "process",
      "command": "bun",
      "args": [
        "run",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Full suite, including historical failures; not a paid campaign.",
      "group": "test"
    }
  ]
}
