{
  "name": "agent-plugin",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "commander": "15.0.0",
    "yaml": "2.8.1"
  },
  "scripts": {
    "start": "node src/index.ts",
    "build": "node scripts/build.mjs",
    "lint": "biome lint --error-on-warnings ./src ./tests",
    "lint:fix": "biome lint --write --error-on-warnings ./src ./tests",
    "test": "node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "typecheck:source": "tsc --noEmit",
    "package:runtime": "node scripts/package-runtime.mjs"
  }
}
