{
  "name": "agent-plugin",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "yaml": "2.8.1"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "lint": "biome lint --error-on-warnings ./src ./tests",
    "lint:fix": "biome lint --write --error-on-warnings ./src ./tests",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit"
  }
}
