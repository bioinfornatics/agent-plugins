{
  "bunVersion": "1.3.12",
  "stagingRoot": "release-staging",
  "targets": {
    "linux-x64": "bun-linux-x64-baseline",
    "linux-arm64": "bun-linux-arm64",
    "darwin-x64": "bun-darwin-x64",
    "darwin-arm64": "bun-darwin-arm64",
    "win32-x64": "bun-windows-x64-baseline"
  },
  "portablePluginEntries": [
    "plugin.json",
    "LICENSE"
  ],
  "portableSkillEntries": [
    "AGENTS.md",
    "LICENSE.txt",
    "README.md",
    "SKILL.md",
    "THIRD_PARTY_NOTICES.md",
    "agents",
    "assets",
    "evals",
    "references",
    "schemas"
  ],
  "skills": [
    "agent-creator",
    "hook-creator",
    "plugin-creator",
    "plugin-script-packaging",
    "skill-creator"
  ],
  "executables": {
    "skill-creator": "apps/skill-creator-cli/scripts/bun-entry.ts",
    "agent-creator": "apps/agent-creator-cli/scripts/bun-entry.ts",
    "hook-creator": "apps/hook-creator-cli/scripts/bun-entry.ts",
    "plugin-creator": "apps/plugin-creator-cli/scripts/bun-entry.ts"
  },
  "runtimeProfiles": {
    "source": {
      "mode": "node-bundled",
      "launcherSuffix": ".mjs",
      "requiredSkillEntries": [
        "scripts",
        "runtime"
      ]
    },
    "native": {
      "mode": "native-bun",
      "excludedSkillEntries": [
        "runtime",
        "node_modules"
      ],
      "excludedScriptSuffixes": [
        ".mjs"
      ]
    }
  }
}
