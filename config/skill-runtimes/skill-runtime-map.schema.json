{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/skill-runtime-map.schema.json",
  "title": "Canonical per-Skill Node runtime mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "node",
    "skills"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./skill-runtime-map.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "node": {
      "type": "string",
      "pattern": "^>=22(?:\\.0\\.0)?$"
    },
    "skills": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logicalName",
          "skill",
          "app",
          "sourceEntry",
          "emittedEntry",
          "resources",
          "relatedCommands"
        ],
        "properties": {
          "logicalName": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "skill": {
            "type": "string",
            "pattern": "^skills/[a-z][a-z0-9-]*$"
          },
          "app": {
            "type": "string",
            "pattern": "^apps/[a-z][a-z0-9-]*-cli$"
          },
          "sourceEntry": {
            "type": "string",
            "pattern": "^scripts/[a-zA-Z0-9_./-]+\\.ts$"
          },
          "emittedEntry": {
            "type": "string",
            "pattern": "^dist/[a-zA-Z0-9_./-]+\\.js$"
          },
          "resources": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^dist/[a-zA-Z0-9_./-]+$"
            }
          },
          "relatedCommands": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        }
      }
    }
  }
}
