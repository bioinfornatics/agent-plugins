{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/skill-runtime-map.schema.json",
  "title": "Canonical agent-plugin Skill Node runtime mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "node",
    "skills"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./skill-runtime-map.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "node": {
      "type": "string",
      "const": ">=22.22.2"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logicalName",
          "skill",
          "app",
          "sourceEntry",
          "emittedEntry",
          "resources",
          "relatedCommands"
        ],
        "properties": {
          "logicalName": {
            "type": "string",
            "const": "skill-creator"
          },
          "skill": {
            "type": "string",
            "const": "skills/skill-creator"
          },
          "app": {
            "type": "string",
            "const": "apps/agent-plugin"
          },
          "sourceEntry": {
            "type": "string",
            "const": "src/index.ts"
          },
          "emittedEntry": {
            "type": "string",
            "const": "dist/index.js"
          },
          "resources": {
            "type": "array",
            "maxItems": 0
          },
          "relatedCommands": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 0
          }
        }
      }
    }
  }
}
