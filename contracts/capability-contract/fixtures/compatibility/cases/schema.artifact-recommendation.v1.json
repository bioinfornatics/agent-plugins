{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.dev/schemas/artifact-recommendation/1.0.0",
  "title": "Artifact Recommendation API v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "recommendation",
    "confidence",
    "alternatives",
    "assumptions",
    "rationale",
    "portability",
    "creatorBridge",
    "override"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "recommendation": {
      "enum": [
        "skill",
        "agent",
        "hook",
        "mcp",
        "recipe",
        "plugin"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "rationale"
        ],
        "properties": {
          "type": {
            "enum": [
              "skill",
              "agent",
              "hook",
              "mcp",
              "recipe",
              "plugin"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "scope"
      ],
      "properties": {
        "level": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "creatorBridge": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "target"
          ],
          "properties": {
            "status": {
              "const": "available"
            },
            "target": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "reason"
      ],
      "properties": {
        "requested": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "not-requested",
            "respected",
            "unsafe",
            "unsupported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
