{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agent-plugins.org/schemas/feedback-annotation/1.0.0/feedback-annotation.schema.json","title":"Versioned Feedback Annotation","type":"object","additionalProperties":false,"required":["schemaVersion","annotationId","anchor","reviewer","createdAt","instruction","annotationHash"],"properties":{"schemaVersion":{"const":"1.0.0"},"annotationId":{"$ref":"#/$defs/id"},"anchor":{"$ref":"#/$defs/anchor"},"reviewer":{"$ref":"#/$defs/reviewer"},"createdAt":{"$ref":"#/$defs/instant"},"instruction":{"type":"string","minLength":1,"maxLength":10000},"annotationHash":{"$ref":"#/$defs/hash"}},"$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"instant":{"type":"string","format":"date-time","pattern":"Z$"},"reviewer":{"type":"object","additionalProperties":false,"required":["reviewerId","role"],"properties":{"reviewerId":{"$ref":"#/$defs/id"},"displayName":{"type":"string","minLength":1,"maxLength":200},"role":{"$ref":"#/$defs/id"}}},"region":{"type":"object","additionalProperties":false,"required":["x","y","width","height","unit"],"properties":{"x":{"type":"number","minimum":0},"y":{"type":"number","minimum":0},"width":{"type":"number","exclusiveMinimum":0},"height":{"type":"number","exclusiveMinimum":0},"unit":{"enum":["px","percent"]}}},"anchor":{"type":"object","additionalProperties":false,"required":["kind","resourceId","revision","resourceHash"],"properties":{"kind":{"enum":["product","scenario","output","grade","region"]},"resourceId":{"$ref":"#/$defs/id"},"revision":{"type":"integer","minimum":0},"resourceHash":{"$ref":"#/$defs/hash"},"selector":{"type":"string","minLength":1,"maxLength":2000},"region":{"$ref":"#/$defs/region"}},"allOf":[{"if":{"properties":{"kind":{"const":"region"}}},"then":{"properties":{"region":{"$ref":"#/$defs/region"}},"required":["region"]},"else":{"not":{"required":["region"]}}}]}}}
