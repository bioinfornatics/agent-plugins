{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agent-plugins.org/schemas/feedback-annotation/1.0.0/feedback-decision.schema.json","title":"Versioned Feedback Decision","type":"object","additionalProperties":false,"required":["schemaVersion","decisionId","proposalId","proposalHash","decision","rationale","reviewer","decidedAt","expectedRevision","expectedResourceHash","previewHash","decisionHash"],"properties":{"schemaVersion":{"const":"1.0.0"},"decisionId":{"$ref":"#/$defs/id"},"proposalId":{"$ref":"#/$defs/id"},"proposalHash":{"$ref":"#/$defs/hash"},"decision":{"enum":["accepted","rejected"]},"rationale":{"type":"string","minLength":1,"maxLength":10000},"reviewer":{"type":"object","additionalProperties":false,"required":["reviewerId","role"],"properties":{"reviewerId":{"$ref":"#/$defs/id"},"displayName":{"type":"string","minLength":1,"maxLength":200},"role":{"$ref":"#/$defs/id"}}},"decidedAt":{"type":"string","format":"date-time","pattern":"Z$"},"expectedRevision":{"type":"integer","minimum":0},"expectedResourceHash":{"$ref":"#/$defs/hash"},"previewHash":{"$ref":"#/$defs/hash"},"decisionHash":{"$ref":"#/$defs/hash"}},"$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}
