{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/host-execution-adapter/1.0.0/host-execution-adapter.schema.json",
  "title": "Agent Plugins Host Execution Adapter Protocol 1.0.0",
  "description": "Process-neutral host capability, execution, cancellation, resume, and artifact exchange messages.",
  "oneOf": [
    {
      "$ref": "#/$defs/capabilityReport"
    },
    {
      "$ref": "#/$defs/negotiationRequest"
    },
    {
      "$ref": "#/$defs/negotiationAccepted"
    },
    {
      "$ref": "#/$defs/negotiationBlocked"
    },
    {
      "$ref": "#/$defs/runRequest"
    },
    {
      "$ref": "#/$defs/cancellationRequest"
    },
    {
      "$ref": "#/$defs/cancellationResponse"
    },
    {
      "$ref": "#/$defs/resumeRequest"
    },
    {
      "$ref": "#/$defs/artifactRequest"
    },
    {
      "$ref": "#/$defs/artifactExchange"
    }
  ],
  "$defs": {
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "$ref": "#/$defs/nonBlank"
    },
    "protocolVersion": {
      "const": "1.0.0"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonBlank"
      },
      "uniqueItems": true
    },
    "host": {
      "type": "object",
      "required": [
        "name",
        "version",
        "adapterVersion"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonBlank"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "adapterVersion": {
          "$ref": "#/$defs/version"
        }
      },
      "additionalProperties": false
    },
    "capabilityName": {
      "enum": [
        "isolation",
        "streaming",
        "cancellation",
        "resume",
        "model",
        "tools",
        "filesystem",
        "network",
        "browser",
        "tokenMetrics",
        "costMetrics"
      ]
    },
    "requirement": {
      "type": "object",
      "required": [
        "capability"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/capabilityName"
        },
        "value": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonBlank"
            },
            {
              "$ref": "#/$defs/stringList"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      },
      "additionalProperties": false
    },
    "degradation": {
      "type": "object",
      "required": [
        "capability",
        "code",
        "message"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/capabilityName"
        },
        "code": {
          "const": "OPTIONAL_CAPABILITY_UNAVAILABLE"
        },
        "message": {
          "$ref": "#/$defs/nonBlank"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "PROTOCOL_VERSION_UNSUPPORTED",
            "REQUIRED_CAPABILITY_MISSING",
            "RUN_REQUEST_INVALID",
            "WORKSPACE_BOUNDARY_VIOLATION",
            "FILE_BOUNDARY_VIOLATION",
            "TOOL_NOT_ALLOWED",
            "ENVIRONMENT_NOT_ALLOWED",
            "CREDENTIAL_VALUE_FORBIDDEN",
            "SECRET_IN_EVENT",
            "EVENT_SEQUENCE_INVALID",
            "ARTIFACT_INVALID",
            "RUN_NOT_FOUND",
            "RESUME_INVALID",
            "RESUME_STALE",
            "CANCELLATION_UNSUPPORTED",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "$ref": "#/$defs/nonBlank"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "capabilityReport": {
      "type": "object",
      "required": [
        "protocolVersion",
        "supportedProtocolVersions",
        "host",
        "isolation",
        "streaming",
        "cancellation",
        "resume",
        "supportedModels",
        "supportedTools",
        "filesystem",
        "network",
        "browser",
        "metrics",
        "allowedEnvironmentNames"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "supportedProtocolVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/version"
          },
          "uniqueItems": true
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "isolation": {
          "type": "object",
          "required": [
            "supported",
            "levels"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "levels": {
              "type": "array",
              "items": {
                "enum": [
                  "none",
                  "process",
                  "container",
                  "virtual-machine"
                ]
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "streaming": {
          "type": "object",
          "required": [
            "supported",
            "transports"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "transports": {
              "type": "array",
              "items": {
                "enum": [
                  "iterator",
                  "jsonl"
                ]
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "cancellation": {
          "type": "object",
          "required": [
            "supported"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "resume": {
          "type": "object",
          "required": [
            "supported"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "tokenTtlSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "supportedModels": {
          "$ref": "#/$defs/stringList"
        },
        "supportedTools": {
          "$ref": "#/$defs/stringList"
        },
        "filesystem": {
          "type": "object",
          "required": [
            "supported",
            "modes",
            "workspaceContained"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "modes": {
              "type": "array",
              "items": {
                "enum": [
                  "read",
                  "write"
                ]
              },
              "uniqueItems": true
            },
            "workspaceContained": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "required": [
            "supported",
            "allowlistEnforced"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "allowlistEnforced": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "browser": {
          "type": "object",
          "required": [
            "supported"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "required": [
            "tokens",
            "cost"
          ],
          "properties": {
            "tokens": {
              "type": "boolean"
            },
            "cost": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "allowedEnvironmentNames": {
          "$ref": "#/$defs/stringList"
        }
      },
      "additionalProperties": false
    },
    "negotiationRequest": {
      "type": "object",
      "required": [
        "supportedProtocolVersions",
        "capabilities"
      ],
      "properties": {
        "supportedProtocolVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/version"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "$ref": "#/$defs/requirements"
        }
      },
      "additionalProperties": false
    },
    "negotiationAccepted": {
      "type": "object",
      "required": [
        "compatible",
        "protocolVersion",
        "host",
        "report",
        "degradations"
      ],
      "properties": {
        "compatible": {
          "const": true
        },
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "report": {
          "$ref": "#/$defs/capabilityReport"
        },
        "degradations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/degradation"
          }
        }
      },
      "additionalProperties": false
    },
    "negotiationBlocked": {
      "type": "object",
      "required": [
        "compatible",
        "host",
        "report",
        "errors"
      ],
      "properties": {
        "compatible": {
          "const": false
        },
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "report": {
          "$ref": "#/$defs/capabilityReport"
        },
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "mediaType",
        "size",
        "access"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonBlank"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mediaType": {
          "$ref": "#/$defs/nonBlank"
        },
        "size": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "access": {
          "enum": [
            "read",
            "write",
            "read-write"
          ]
        }
      },
      "additionalProperties": false
    },
    "credential": {
      "type": "object",
      "required": [
        "name",
        "reference"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonBlank"
        },
        "reference": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^ \t\r\n]+$"
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "runId",
        "planId",
        "scenarioId",
        "configurationId",
        "attempt"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/nonBlank"
        },
        "planId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "scenarioId": {
          "$ref": "#/$defs/nonBlank"
        },
        "configurationId": {
          "$ref": "#/$defs/nonBlank"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "idempotency": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/nonBlank"
        },
        "resumeToken": {
          "$ref": "#/$defs/nonBlank"
        },
        "afterSequence": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlank"
        },
        "source": {
          "$ref": "#/$defs/nonBlank"
        },
        "selector": {
          "$ref": "#/$defs/nonBlank"
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": [
        "maxTurns",
        "timeoutSeconds"
      ],
      "properties": {
        "maxTurns": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxCostUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "runRequest": {
      "type": "object",
      "required": [
        "protocolVersion",
        "host",
        "identity",
        "plan",
        "scenario",
        "workspace",
        "tools",
        "environment",
        "model",
        "budget",
        "capabilities",
        "idempotency"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "plan": {
          "$ref": "https://agent-plugins.org/schemas/evaluation-plan/1.0.0/evaluation-plan.schema.json"
        },
        "scenario": {
          "$ref": "#/$defs/scenario"
        },
        "workspace": {
          "type": "object",
          "required": [
            "root",
            "cwd",
            "files"
          ],
          "properties": {
            "root": {
              "$ref": "#/$defs/nonBlank"
            },
            "cwd": {
              "$ref": "#/$defs/nonBlank"
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file"
              }
            }
          },
          "additionalProperties": false
        },
        "tools": {
          "$ref": "#/$defs/stringList"
        },
        "environment": {
          "type": "object",
          "required": [
            "names",
            "credentials"
          ],
          "properties": {
            "names": {
              "$ref": "#/$defs/stringList"
            },
            "credentials": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/credential"
              }
            }
          },
          "additionalProperties": false
        },
        "model": {
          "$ref": "#/$defs/nonBlank"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "capabilities": {
          "$ref": "#/$defs/requirements"
        },
        "idempotency": {
          "$ref": "#/$defs/idempotency"
        }
      },
      "additionalProperties": false
    },
    "baseMessage": {
      "type": "object",
      "required": [
        "protocolVersion",
        "host",
        "runId"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "runId": {
          "$ref": "#/$defs/nonBlank"
        }
      }
    },
    "cancellationRequest": {
      "type": "object",
      "required": [
        "protocolVersion",
        "host",
        "runId",
        "reason",
        "idempotencyKey"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "runId": {
          "$ref": "#/$defs/nonBlank"
        },
        "reason": {
          "$ref": "#/$defs/nonBlank"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/nonBlank"
        }
      },
      "additionalProperties": false
    },
    "cancellationResponse": {
      "type": "object",
      "required": [
        "protocolVersion",
        "host",
        "runId",
        "status"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "runId": {
          "$ref": "#/$defs/nonBlank"
        },
        "status": {
          "enum": [
            "cancel-requested",
            "already-cancelled",
            "already-terminal"
          ]
        }
      },
      "additionalProperties": false
    },
    "resumeRequest": {
      "type": "object",
      "required": [
        "protocolVersion",
        "host",
        "runId",
        "resumeToken",
        "afterSequence"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "runId": {
          "$ref": "#/$defs/nonBlank"
        },
        "resumeToken": {
          "$ref": "#/$defs/nonBlank"
        },
        "afterSequence": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      },
      "additionalProperties": false
    },
    "artifactRequest": {
      "type": "object",
      "required": [
        "protocolVersion",
        "host",
        "runId",
        "artifactId"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "runId": {
          "$ref": "#/$defs/nonBlank"
        },
        "artifactId": {
          "$ref": "#/$defs/nonBlank"
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifactId",
        "path",
        "sha256",
        "mediaType",
        "size"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/nonBlank"
        },
        "path": {
          "$ref": "#/$defs/nonBlank"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mediaType": {
          "$ref": "#/$defs/nonBlank"
        },
        "size": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      },
      "additionalProperties": false
    },
    "artifactExchange": {
      "type": "object",
      "required": [
        "protocolVersion",
        "host",
        "runId",
        "artifact",
        "encoding",
        "content"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "runId": {
          "$ref": "#/$defs/nonBlank"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "encoding": {
          "const": "base64"
        },
        "content": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "additionalProperties": false
    }
  }
}
