{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/host-execution-adapter/1.0.0/host-execution-event.schema.json",
  "title": "Agent Plugins Host Execution JSONL Event 1.0.0",
  "description": "One ordered, non-secret event envelope per JSONL line.",
  "type": "object",
  "required": [
    "protocolVersion",
    "host",
    "runId",
    "sequence",
    "timestamp",
    "type",
    "data"
  ],
  "properties": {
    "protocolVersion": {
      "const": "1.0.0"
    },
    "host": {
      "type": "object",
      "required": [
        "name",
        "version",
        "adapterVersion"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonBlank"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "adapterVersion": {
          "$ref": "#/$defs/version"
        }
      },
      "additionalProperties": false
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "type": {
      "enum": [
        "accepted",
        "started",
        "progress",
        "heartbeat",
        "artifact",
        "completed",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "accepted"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "degradations"
            ],
            "properties": {
              "resumeToken": {
                "$ref": "#/$defs/nonBlank"
              },
              "degradations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/degradation"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "started"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [],
            "properties": {
              "message": {
                "$ref": "#/$defs/nonBlank"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "progress"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "$ref": "#/$defs/nonBlank"
              },
              "completed": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "heartbeat"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [],
            "properties": {
              "message": {
                "$ref": "#/$defs/nonBlank"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "artifact"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "artifact"
            ],
            "properties": {
              "artifact": {
                "$ref": "#/$defs/artifact"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "$ref": "#/$defs/result"
              },
              "metrics": {
                "$ref": "#/$defs/metrics"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "blocked"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "result",
              "error"
            ],
            "properties": {
              "result": {
                "$ref": "#/$defs/result"
              },
              "error": {
                "$ref": "#/$defs/error"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "failed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "result",
              "error"
            ],
            "properties": {
              "result": {
                "$ref": "#/$defs/result"
              },
              "error": {
                "$ref": "#/$defs/error"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "cancelled"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "$ref": "#/$defs/nonBlank"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "$defs": {
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "host": {
      "type": "object",
      "required": [
        "name",
        "version",
        "adapterVersion"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonBlank"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "adapterVersion": {
          "$ref": "#/$defs/version"
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifactId",
        "path",
        "sha256",
        "mediaType",
        "size"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/nonBlank"
        },
        "path": {
          "$ref": "#/$defs/nonBlank"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mediaType": {
          "$ref": "#/$defs/nonBlank"
        },
        "size": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      },
      "additionalProperties": false
    },
    "degradation": {
      "type": "object",
      "required": [
        "capability",
        "code",
        "message"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/capabilityName"
        },
        "code": {
          "const": "OPTIONAL_CAPABILITY_UNAVAILABLE"
        },
        "message": {
          "$ref": "#/$defs/nonBlank"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "PROTOCOL_VERSION_UNSUPPORTED",
            "REQUIRED_CAPABILITY_MISSING",
            "RUN_REQUEST_INVALID",
            "WORKSPACE_BOUNDARY_VIOLATION",
            "FILE_BOUNDARY_VIOLATION",
            "TOOL_NOT_ALLOWED",
            "ENVIRONMENT_NOT_ALLOWED",
            "CREDENTIAL_VALUE_FORBIDDEN",
            "SECRET_IN_EVENT",
            "EVENT_SEQUENCE_INVALID",
            "ARTIFACT_INVALID",
            "RUN_NOT_FOUND",
            "RESUME_INVALID",
            "RESUME_STALE",
            "CANCELLATION_UNSUPPORTED",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "$ref": "#/$defs/nonBlank"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "$ref": "https://agent-plugins.org/schemas/result-contract/1.0.0/result-contract.schema.json"
    },
    "metrics": {
      "type": "object",
      "required": [],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "capabilityName": {
      "enum": [
        "isolation",
        "streaming",
        "cancellation",
        "resume",
        "model",
        "tools",
        "filesystem",
        "network",
        "browser",
        "tokenMetrics",
        "costMetrics"
      ]
    }
  }
}
