{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.dev/schemas/adaptive-elicitation/1.0.0",
  "title": "Adaptive bounded elicitation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recommendation", "model", "questions", "deferredMandatoryFieldIds", "preview"],
  "properties": {
    "version": { "const": "1.0.0" },
    "recommendation": { "$ref": "../../recommendation/1.0.0/artifact-recommendation.schema.json" },
    "model": {
      "type": "object", "additionalProperties": false, "required": ["fields"],
      "properties": { "fields": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/field" } } }
    },
    "questions": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/question" } },
    "deferredMandatoryFieldIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["ready", "unansweredOptionalFieldIds", "appliedDefaults", "blockers"],
      "properties": {
        "ready": { "type": "boolean" },
        "unansweredOptionalFieldIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "appliedDefaults": { "type": "array", "items": { "$ref": "#/$defs/appliedDefault" } },
        "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "state": { "enum": ["known", "assumed", "unknown", "contradictory"] },
    "decision": { "enum": ["architecture", "safety", "evaluation"] },
    "ambiguity": { "enum": ["ordinary", "destructive", "security", "production", "untestable"] },
    "default": {
      "type": "object", "additionalProperties": false, "required": ["value", "reversible", "consequence"],
      "properties": { "value": { "type": "string", "minLength": 1 }, "reversible": { "const": true }, "consequence": { "type": "string", "minLength": 1 } }
    },
    "appliedDefault": {
      "type": "object", "additionalProperties": false, "required": ["fieldId", "value", "reversible", "consequence"],
      "properties": { "fieldId": { "$ref": "#/$defs/id" }, "value": { "type": "string", "minLength": 1 }, "reversible": { "const": true }, "consequence": { "type": "string", "minLength": 1 } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["id", "state", "summary"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "state": { "$ref": "#/$defs/state" }, "summary": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 } }
    },
    "field": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "state", "evidence", "decisions", "ambiguity", "question"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1 }, "state": { "$ref": "#/$defs/state" }, "value": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/evidence" } },
        "decisions": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/decision" } },
        "ambiguity": { "$ref": "#/$defs/ambiguity" }, "question": { "type": "string", "minLength": 1 }, "default": { "$ref": "#/$defs/default" }
      },
      "allOf": [{ "if": { "properties": { "ambiguity": { "enum": ["destructive", "security", "production", "untestable"] } }, "required": ["ambiguity"] }, "then": { "not": { "required": ["default"] } } }]
    },
    "question": {
      "type": "object", "additionalProperties": false, "required": ["id", "fieldId", "prompt", "mandatory", "ambiguity", "value"],
      "properties": {
        "id": { "type": "string", "pattern": "^field:[a-z0-9][a-z0-9._:-]{0,127}$" }, "fieldId": { "$ref": "#/$defs/id" }, "prompt": { "type": "string", "minLength": 1 }, "mandatory": { "type": "boolean" }, "ambiguity": { "$ref": "#/$defs/ambiguity" },
        "value": { "type": "object", "additionalProperties": false, "required": ["score", "decisions", "rationale"], "properties": { "score": { "type": "integer", "minimum": 0 }, "decisions": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/decision" } }, "rationale": { "type": "string", "minLength": 1 } } },
        "default": { "$ref": "#/$defs/default" }
      }
    }
  }
}
