{
  "name": "agent-plugins-development",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:skill-runtimes": "node scripts/generate-skill-runtimes.mjs",
    "check:skill-runtime-dist-drift": "node scripts/check-skill-runtime-dist-drift.mjs",
    "prepare:offline": "node scripts/prepare-offline-bundle.mjs",
    "test:offline": "node scripts/test-offline-bundle.mjs",
    "test:distribution": "node --test tests/test_distribution.test.ts",
    "test": "node scripts/test.mjs",
    "package:offline": "node scripts/package-offline.mjs",
    "build:executables": "node scripts/build-bun-executables.mjs",
    "test:executables": "bun run build:executables && node --test tests/test_bun_executables.test.ts",
    "test:release": "bun test tests/test_bun_release_workflow.test.ts && node --test tests/test_release_packaging.test.ts",
    "test:reproducibility": "node scripts/test-clean-source-reproducibility.mjs",
    "stage:release": "node scripts/build-bun-executables.mjs",
    "package:release": "node scripts/package-bun-release-assets.mjs",
    "bundle": "node scripts/build-bun-executables.mjs",
    "release": "node scripts/release-all.mjs",
    "test:facade": "node --test tests/test_developer_facade.test.ts tests/test_clean.test.ts",
    "test:clean": "node --test tests/test_clean.test.ts",
    "install:plugin": "node scripts/install-staged-plugin.mjs",
    "check:change-set-inventory": "node scripts/validate-change-set-inventory.mjs",
    "prepare:development": "node scripts/prepare-development.mjs",
    "project:production": "node scripts/production.mjs project .artifacts/production",
    "test:production": "node --test tests/test_production.test.ts",
    "promote:production": "node scripts/promote-production.mjs",
    "test:production-ci": "node scripts/test.mjs --profile=production",
    "test:reproducibility-build": "node scripts/test-clean-source-reproducibility.mjs --build-only"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": "=1.3.12"
  }
}
