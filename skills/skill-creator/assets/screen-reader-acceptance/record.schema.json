{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/skill-creator/screen-reader-acceptance-record.schema.json",
  "title": "Anonymous manual screen-reader acceptance record",
  "description": "Strict structured record. Runtime validation binds canonical protocol identity and exact mode/task expectations, checks dates, evidence quality, complete task matrices, privacy, versions, and report build consistency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "record_id",
    "synthetic",
    "availability",
    "unavailable_reason",
    "reviewed_at",
    "reviewer_code",
    "privacy_reviewed",
    "retention",
    "environment",
    "tasks",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^SR-[A-Z0-9]{8}$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "availability": {
      "enum": [
        "performed",
        "unavailable"
      ]
    },
    "unavailable_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reviewer_code": {
      "type": "string",
      "pattern": "^REV-[A-Z0-9]{4,12}$"
    },
    "privacy_reviewed": {
      "const": true
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "delete_after"
      ],
      "properties": {
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "delete_after": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "assistive_technology",
        "browser",
        "report_build"
      ],
      "properties": {
        "os": {
          "$ref": "#/$defs/os"
        },
        "assistive_technology": {
          "$ref": "#/$defs/at"
        },
        "browser": {
          "$ref": "#/$defs/browser"
        },
        "report_build": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "task_id",
          "expected",
          "observed",
          "pass",
          "evidence"
        ],
        "properties": {
          "mode": {
            "enum": [
              "static",
              "live"
            ]
          },
          "task_id": {
            "$ref": "#/$defs/task"
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "observed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "pass": {
            "type": "boolean"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locator",
              "observation"
            ],
            "properties": {
              "locator": {
                "type": "string",
                "minLength": 5,
                "maxLength": 160
              },
              "observation": {
                "type": "string",
                "minLength": 12,
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "task_id",
          "mode",
          "summary",
          "evidence",
          "privacy_reviewed"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^SR-[A-Z0-9-]{2,30}$"
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "task_id": {
            "$ref": "#/$defs/task"
          },
          "mode": {
            "enum": [
              "static",
              "live"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locator",
              "observation"
            ],
            "properties": {
              "locator": {
                "type": "string",
                "minLength": 5,
                "maxLength": 160
              },
              "observation": {
                "type": "string",
                "minLength": 12,
                "maxLength": 500
              }
            }
          },
          "privacy_reviewed": {
            "const": true
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "versioned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "enum": [
            "Windows",
            "macOS"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?(?:[-+][0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
        }
      }
    },
    "at": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "enum": [
            "NVDA",
            "VoiceOver"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?(?:[-+][0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "enum": [
            "Firefox",
            "Chrome",
            "Safari"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?(?:[-+][0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
        }
      }
    },
    "task": {
      "enum": [
        "headings-landmarks",
        "filters-announcements",
        "deep-link-focus",
        "pagination",
        "disclosure",
        "status-noncolor"
      ]
    }
  }
}
